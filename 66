using FluentAssertions;
using FractionLib;

namespace UnitTesting.Tests;

public class FractionTests
{
    [Fact]
    public void Constructor_ShouldReduceFraction()
    {
        // Arrange
        int numerator = 6;
        int denominator = 8;

        // Act
        var fraction = new Fraction(numerator, denominator);

        // Assert
        fraction.Numerator.Should().Be(3);
        fraction.Denominator.Should().Be(4);
    }

    [Fact]
    public void Constructor_ShouldThrow_WhenDenominatorIsZero()
    {
        // Arrange
        int numerator = 1;
        int denominator = 0;

        // Act
        Action act = () => new Fraction(numerator, denominator);

        // Assert
        act.Should().Throw<DivideByZeroException>()
            .WithMessage("Denominator cannot be zero.");
    }

    [Theory]
    [InlineData(1, 2, 3, 4, 5, 4)]
    [InlineData(1, 3, 1, 3, 2, 3)]
    [InlineData(-1, 2, 1, 4, -1, 4)]
    public void Add_ShouldReturnCorrectResult(
        int firstNumerator,
        int firstDenominator,
        int secondNumerator,
        int secondDenominator,
        int expectedNumerator,
        int expectedDenominator)
    {
        // Arrange
        var first = new Fraction(firstNumerator, firstDenominator);
        var second = new Fraction(secondNumerator, secondDenominator);

        // Act
        var result = first + second;

        // Assert
        result.Should().Be(new Fraction(expectedNumerator, expectedDenominator));
    }

    [Theory]
    [InlineData(3, 4, 1, 4, 1, 2)]
    [InlineData(1, 2, 1, 2, 0, 1)]
    [InlineData(-1, 2, 1, 4, -3, 4)]
    public void Subtract_ShouldReturnCorrectResult(
        int firstNumerator,
        int firstDenominator,
        int secondNumerator,
        int secondDenominator,
        int expectedNumerator,
        int expectedDenominator)
    {
        // Arrange
        var first = new Fraction(firstNumerator, firstDenominator);
        var second = new Fraction(secondNumerator, secondDenominator);

        // Act
        var result = first - second;

        // Assert
        result.Should().Be(new Fraction(expectedNumerator, expectedDenominator));
    }

    [Theory]
    [InlineData(1, 2, 2, 3, 1, 3)]
    [InlineData(3, 4, 2, 5, 3, 10)]
    [InlineData(-1, 2, 2, 3, -1, 3)]
    public void Multiply_ShouldReturnCorrectResult(
        int firstNumerator,
        int firstDenominator,
        int secondNumerator,
        int secondDenominator,
        int expectedNumerator,
        int expectedDenominator)
    {
        // Arrange
        var first = new Fraction(firstNumerator, firstDenominator);
        var second = new Fraction(secondNumerator, secondDenominator);

        // Act
        var result = first * second;

        // Assert
        result.Should().Be(new Fraction(expectedNumerator, expectedDenominator));
    }

    [Theory]
    [InlineData(1, 2, 1, 4, 2, 1)]
    [InlineData(3, 4, 2, 5, 15, 8)]
    [InlineData(-1, 2, 2, 3, -3, 4)]
    public void Divide_ShouldReturnCorrectResult(
        int firstNumerator,
        int firstDenominator,
        int secondNumerator,
        int secondDenominator,
        int expectedNumerator,
        int expectedDenominator)
    {
        // Arrange
        var first = new Fraction(firstNumerator, firstDenominator);
        var second = new Fraction(secondNumerator, secondDenominator);

        // Act
        var result = first / second;

        // Assert
        result.Should().Be(new Fraction(expectedNumerator, expectedDenominator));
    }

    [Fact]
    public void Divide_ShouldThrow_WhenDivisorIsZero()
    {
        // Arrange
        var first = new Fraction(1, 2);
        var second = new Fraction(0, 1);

        // Act
        Action act = () => first / second;

        // Assert
        act.Should().Throw<DivideByZeroException>()
            .WithMessage("Cannot divide by zero.");
    }

    [Theory]
    [InlineData(3, 2, 1.5)]
    [InlineData(1, 4, 0.25)]
    [InlineData(-1, 2, -0.5)]
    public void ToDouble_ShouldReturnCorrectValue(
        int numerator,
        int denominator,
        double expected)
    {
        // Arrange
        var fraction = new Fraction(numerator, denominator);

        // Act
        var result = fraction.ToDouble();

        // Assert
        result.Should().BeApproximately(expected, 0.000001);
    }

    [Theory]
    [InlineData(7, 2, 3)]
    [InlineData(1, 2, 0)]
    [InlineData(-7, 2, -3)]
    public void ToInt_ShouldReturnIntegerPart(
        int numerator,
        int denominator,
        int expected)
    {
        // Arrange
        var fraction = new Fraction(numerator, denominator);

        // Act
        var result = fraction.ToInt();

        // Assert
        result.Should().Be(expected);
    }

    [Theory]
    [InlineData(3, 4, "3/4")]
    [InlineData(-1, 2, "-1/2")]
    [InlineData(5, 1, "5/1")]
    public void ToString_ShouldReturnFractionAsString(
        int numerator,
        int denominator,
        string expected)
    {
        // Arrange
        var fraction = new Fraction(numerator, denominator);

        // Act
        var result = fraction.ToString();

        // Assert
        result.Should().Be(expected);
    }

    [Theory]
    [InlineData(1, 2, 1, 2, true)]
    [InlineData(1, 2, 2, 4, true)]
    [InlineData(1, 2, 2, 3, false)]
    public void Equals_ShouldReturnExpectedResult(
        int firstNumerator,
        int firstDenominator,
        int secondNumerator,
        int secondDenominator,
        bool expected)
    {
        // Arrange
        var first = new Fraction(firstNumerator, firstDenominator);
        var second = new Fraction(secondNumerator, secondDenominator);

        // Act
        var result = first.Equals(second);

        // Assert
        result.Should().Be(expected);
    }

    [Theory]
    [InlineData(1, 2, 1, 2, true)]
    [InlineData(1, 2, 2, 3, false)]
    public void Equals_Object_ShouldReturnExpectedResult(
        int firstNumerator,
        int firstDenominator,
        int secondNumerator,
        int secondDenominator,
        bool expected)
    {
        // Arrange
        var first = new Fraction(firstNumerator, firstDenominator);
        object second = new Fraction(secondNumerator, secondDenominator);

        // Act
        var result = first.Equals(second);

        // Assert
        result.Should().Be(expected);
    }

    [Fact]
    public void Equals_Object_ShouldReturnFalse_ForNull()
    {
        // Arrange
        var fraction = new Fraction(1, 2);

        // Act
        var result = fraction.Equals(null);

        // Assert
        result.Should().BeFalse();
    }

    [Theory]
    [MemberData(nameof(CompareTestData))]
    public void CompareTo_ShouldReturnExpectedSign(
        Fraction first,
        Fraction second,
        int expectedSign)
    {
        // Arrange
        // Данные подготовлены через MemberData.

        // Act
        var result = first.CompareTo(second);

        // Assert
        Math.Sign(result).Should().Be(expectedSign);
    }

    public static IEnumerable<object[]> CompareTestData =>
        new[]
        {
            new object[] { new Fraction(3, 4), new Fraction(1, 4), 1 },
            new object[] { new Fraction(1, 4), new Fraction(3, 4), -1 },
            new object[] { new Fraction(1, 2), new Fraction(2, 4), 0 }
        };

    [Fact]
    public void GetHashCode_ShouldBeEqual_ForEqualFractions()
    {
        // Arrange
        var first = new Fraction(1, 2);
        var second = new Fraction(2, 4);

        // Act
        var firstHash = first.GetHashCode();
        var secondHash = second.GetHashCode();

        // Assert
        firstHash.Should().Be(secondHash);
    }
}
